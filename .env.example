# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "production" hides the sample-content ribbon; production builds should also run content:check --strict
NEXT_PUBLIC_SITE_ENV=development

# Contact form (Resend). Without these, the form shows the "Couldn't send" toast with the email fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
IP_HASH_SALT=

# Not used yet: Pearl (week 3), Upstash rate limits, Turnstile
AI_GATEWAY_API_KEY=
PEARL_MODEL=anthropic/claude-haiku-5.5
PEARL_MOCK=1
PEARL_DAILY_MESSAGE_CAP=50
PEARL_LOGGING=
PEARL_APPROVAL_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
COOKIE_SECRET=
SENTRY_DSN=
